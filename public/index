<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sprint Challenge 🎮</title><style>
:root{font-family:Inter,system-ui,Arial,sans-serif;color:#fff;background:#151331}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(circle at 20% 5%,#5433a0 0,transparent 40%),linear-gradient(145deg,#171438,#22205a)}main{max-width:1040px;margin:auto;padding:26px 18px 65px}.top{display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap}.logo{font-size:25px;font-weight:900;letter-spacing:-.8px}.logo span{color:#ffcf45}.panel{background:#ffffff12;border:1px solid #ffffff27;border-radius:23px;padding:25px;margin:22px 0;box-shadow:0 14px 40px #0002}.hero{text-align:center;padding:30px 10px}.hero h1{font-size:clamp(32px,6vw,58px);margin:8px 0}.sub{color:#d7d3fa}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.four{grid-template-columns:repeat(4,minmax(0,1fr))}button,input,textarea,select{font:inherit}button{border:0;border-radius:13px;padding:13px 20px;cursor:pointer;font-weight:800;color:white;background:#7557eb}button:hover{filter:brightness(1.12)}button:disabled{opacity:.45;cursor:not-allowed}button.secondary{background:#ffffff20}button.danger{background:#d84b75}button.good{background:#16a88c}button.full{width:100%}input,textarea,select{background:#ffffff15;border:1px solid #ffffff40;border-radius:12px;padding:13px;color:#fff;width:100%;outline:none}select option{color:#222}textarea{min-height:100px;resize:vertical}label{display:block;font-size:13px;color:#d7d3fa;margin:12px 0 6px}h2{margin:5px 0 12px}h3{margin:5px 0 10px}.muted{color:#c7c1ee;font-size:14px}.tag{display:inline-block;background:#ffffff20;padding:6px 11px;border-radius:30px;font-size:13px}.pin{font-size:42px;font-weight:900;letter-spacing:8px;color:#ffcf45}.question{font-size:clamp(25px,4vw,39px);text-align:center;margin:22px 0 28px}.option{min-height:104px;display:flex;align-items:center;justify-content:center;text-align:center;font-size:18px;border-radius:15px;padding:18px;overflow-wrap:anywhere}.option:nth-child(4n+1){background:#df4263}.option:nth-child(4n+2){background:#2d83df}.option:nth-child(4n+3){background:#d9a022}.option:nth-child(4n+4){background:#159e80}.option.selected{outline:5px solid white;outline-offset:2px}.question-card{background:#211b53;padding:25px;border-radius:20px}.score{font-size:28px;font-weight:900;color:#ffcf45}.timer{font-size:34px;font-weight:900}.person{display:inline-block;margin:5px;padding:9px 13px;background:#ffffff18;border-radius:30px}.card{background:#ffffff10;border-radius:15px;padding:16px;margin:12px 0}.bar{height:13px;border-radius:12px;background:#ffffff25;overflow:hidden}.fill{height:100%;background:#ffcc44}.flex{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.row{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.tiny{font-size:12px;color:#bdb5ed}.divider{border:0;border-top:1px solid #ffffff2b;margin:20px 0}.qedit{background:#ffffff10;padding:17px;border-radius:17px;margin:12px 0}.qedit input,.qedit select{margin-bottom:7px}.notice{padding:12px 16px;border-radius:12px;background:#3b2b7b;margin:14px 0}.error{background:#87314d}.success{background:#176e60}.hide{display:none!important}@media(max-width:650px){.grid,.four{grid-template-columns:1fr}.panel{padding:17px}.pin{font-size:34px}.option{min-height:75px}}
</style></head><body><main><header class="top"><div class="logo">🎮 SPRINT <span>CHALLENGE</span></div><div id="status" class="tag">Conectando…</div></header><div id="app"></div><div id="toast" class="notice hide"></div></main><script src="/socket.io/socket.io.js"></script><script>
const socket=io();const app=document.getElementById('app'),statusEl=document.getElementById('status');let room=null,identity=JSON.parse(localStorage.getItem('sc_identity')||'null'),editing=null,chosen=null,openText='';const esc=x=>String(x??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const $=id=>document.getElementById(id);const avatar=['😎','🦊','🐱','🚀','🦄','🐼','🦁','🎮'];
function toast(msg,bad=false){const e=$('toast');e.textContent=msg;e.className='notice '+(bad?'error':'success');setTimeout(()=>e.classList.add('hide'),4500)}
function send(ev,data,done){socket.emit(ev,data,r=>{if(!r?.ok)toast(r?.error||'Falha na operação.',true);else done?.(r);});}
function saveIdentity(r,name,avatar){identity={code:r.code,id:r.id,token:r.token||null,name,avatar};localStorage.setItem('sc_identity',JSON.stringify(identity));}
function startView(){app.innerHTML=`<div class="hero"><h1>Uma sprint. Muitas histórias.<br>Um desafio coletivo! 🚀</h1><p class="sub">Retrospectiva multiplayer com perguntas, votação e planos de ação.</p></div><div class="grid"><section class="panel"><h2>🎤 Sou facilitador(a)</h2><p class="muted">Crie uma sala e personalize suas perguntas.</p><label>Seu nome</label><input id="hostName" maxlength="35" placeholder="Seu nome"><label>Nome da squad</label><input id="squad" maxlength="65" placeholder="Ex.: Minha Squad"><label>Avatar</label><select id="hostAvatar">${avatar.map(x=>`<option>${x}</option>`).join('')}</select><p><button class="full" onclick="createRoom()">Criar sala ✨</button></p></section><section class="panel"><h2>🎯 Sou participante</h2><p class="muted">Entre com o PIN enviado pelo facilitador.</p><label>PIN da sala</label><input id="joinCode" inputmode="numeric" maxlength="6" placeholder="000000"><label>Seu nome</label><input id="joinName" maxlength="35" placeholder="Seu codinome"><label>Avatar</label><select id="joinAvatar">${avatar.map(x=>`<option>${x}</option>`).join('')}</select><p><button class="full good" onclick="joinRoom()">Entrar no jogo 🎮</button></p></section></div>`;}
function createRoom(){const name=$('hostName').value.trim(),squad=$('squad').value.trim();if(!name)return toast('Informe seu nome.',true);send('create',{name,squad,avatar:$('hostAvatar').value},r=>{saveIdentity(r,name,$('hostAvatar').value);editing=null;});}
function joinRoom(){const name=$('joinName').value.trim(),code=$('joinCode').value.trim();if(!name||code.length!==6)return toast('Informe nome e PIN de 6 dígitos.',true);send('join',{code,name,avatar:$('joinAvatar').value},r=>saveIdentity(r,name,$('joinAvatar').value));}
function isHost(){return !!identity?.token&&room?.participants.some(p=>p.id===identity.id)}
function question(){return room?.questions[room.index]}
function myAnswer(){return room?.answers?.[question()?.id]?.[identity?.id]}
function people(){return `<div>${room.participants.map(p=>`<span class="person">${esc(p.avatar)} ${esc(p.name)} ${p.online?'🟢':'⚪'}</span>`).join('')}</div>`}
function header(){return `<div class="panel"><div class="flex"><div><span class="tag">${esc(room.squad)}</span> <span class="tag">${isHost()?'🎤 Facilitador':'🎮 Participante'}</span><h2>PIN <span class="pin">${esc(room.code)}</span></h2><div class="tiny">Compartilhe o link ${esc(location.origin)} e o PIN com o time</div></div><div><div class="score">⭐ ${room.xp} XP</div><button class="secondary" onclick="copyLink()">Copiar link</button></div></div><hr class="divider"><div class="muted">${room.participants.length} participantes</div>${people()}</div>`}
function copyLink(){navigator.clipboard?.writeText(location.origin).then(()=>toast('Link copiado!')).catch(()=>toast(location.origin));}
function editQuestions(){if(!editing)editing=structuredClone(room.questions);let h=`<div class="panel"><div class="flex"><h2>🛠️ Editor de perguntas</h2><span class="tag">${editing.length} perguntas</span></div><p class="muted">Edite antes de começar. As perguntas são compartilhadas quando você salvar.</p><label>Nome da squad</label><input id="editSquad" value="${esc(room.squad)}"><div id="editList">`;editing.forEach((q,i)=>{h+=`<div class="qedit"><div class="flex"><strong>Questão ${i+1}</strong><div class="row"><button class="secondary" onclick="moveQ(${i},-1)">↑</button><button class="secondary" onclick="moveQ(${i},1)">↓</button><button class="danger" onclick="deleteQ(${i})">Excluir</button></div></div><label>Enunciado</label><input data-i="${i}" data-field="title" value="${esc(q.title)}" maxlength="240"><div class="grid"><div><label>Tipo</label><select data-i="${i}" data-field="type">${[['choice','Múltipla escolha'],['scale','Escala 1 a 5'],['open','Resposta aberta'],['vote','Votação']].map(([v,t])=>`<option value="${v}" ${q.type===v?'selected':''}>${t}</option>`).join('')}</select></div><div><label>Tempo (minutos)</label><input type="number" min="1" max="30" data-i="${i}" data-field="minutes" value="${q.minutes}"></div></div><label><input style="width:auto" type="checkbox" data-i="${i}" data-field="anonymous" ${q.anonymous?'checked':''}> Resposta anônima no resultado</label>${['choice','vote'].includes(q.type)?`<label>Alternativas (uma por linha, de 2 a 6)</label><textarea data-i="${i}" data-field="options">${esc(q.options.join('\n'))}</textarea>`:''}</div>`;});return h+`</div><div class="row"><button class="secondary" onclick="addQ()">+ Nova pergunta</button><button class="secondary" onclick="saveTemplate()">💾 Salvar modelo</button><button class="secondary" onclick="loadTemplate()">📂 Carregar modelo</button><button class="good" onclick="saveQuestions()">Salvar perguntas</button></div></div>`;}
function readEdits(){document.querySelectorAll('[data-i]').forEach(el=>{let q=editing[+el.dataset.i];if(!q)return;let f=el.dataset.field;q[f]=f==='anonymous'?el.checked:f==='minutes'?Number(el.value):f==='options'?el.value.split('\n').map(x=>x.trim()).filter(Boolean):el.value;});}
function addQ(){readEdits();editing.push({id:crypto.randomUUID(),type:'choice',title:'Nova pergunta',options:['Opção 1','Opção 2','Opção 3','Opção 4'],minutes:3,anonymous:false});render();}
function deleteQ(i){readEdits();editing.splice(i,1);render();}
function moveQ(i,d){readEdits();let j=i+d;if(j>=0&&j<editing.length)[editing[i],editing[j]]=[editing[j],editing[i]];render();}
function saveQuestions(){readEdits();send('configure',{questions:editing,squad:$('editSquad').value},()=>{editing=null;toast('Perguntas salvas!');});}
function saveTemplate(){readEdits();localStorage.setItem('sc_template',JSON.stringify(editing));toast('Modelo salvo neste navegador.');}
function loadTemplate(){const saved=localStorage.getItem('sc_template');if(!saved)return toast('Nenhum modelo salvo neste navegador.',true);try{editing=JSON.parse(saved);render();}catch{toast('Modelo inválido.',true)}}
function lobby(){return header()+(isHost()?editQuestions()+`<div class="panel"><h2>🚀 Tudo pronto?</h2><p class="muted">Quando todos entrarem, salve as perguntas e inicie a sessão.</p><button class="good" onclick="control('start')">Iniciar jogo</button></div>`:`<div class="panel hero"><h2>🎉 Você entrou!</h2><p>Aguardando o facilitador iniciar o jogo.</p><p class="muted">Você verá cada pergunta automaticamente.</p></div>`)}
function timer(){const s=room.remaining;return `${Math.floor(s/60).toString().padStart(2,'0')}:${(s%60).toString().padStart(2,'0')}`}
function questionView(){const q=question(),ans=myAnswer();let h=header()+`<div class="panel"><div class="flex"><span class="tag">Pergunta ${room.index+1} de ${room.questions.length}</span><div class="timer">⏱ ${timer()}</div></div><div class="question-card"><div class="question">${esc(q.title)}</div>`;
if(ans){h+=`<div class="hero"><h2>✅ Resposta enviada!</h2><p class="muted">Aguarde o resultado da rodada.</p></div>`;}else if(q.type==='choice'||q.type==='vote'){h+=`<div class="grid">${q.options.map((v,i)=>`<button class="option ${chosen===i?'selected':''}" onclick="choose(${i})">${esc(v)}</button>`).join('')}</div><p class="muted">${q.type==='vote'?'Vote na alternativa que deve receber mais atenção.':'Não existe resposta errada nesta retrospectiva.'}</p>`;}else if(q.type==='scale'){h+=`<div class="grid four">${[1,2,3,4,5].map(v=>`<button class="option" onclick="choose(${v})">${v} ⭐</button>`).join('')}</div>`;}else{h+=`<textarea id="freeAnswer" maxlength="500" placeholder="Escreva sua resposta…">${esc(openText)}</textarea><p><button class="good" onclick="sendOpen()">Enviar resposta</button></p>`;}
h+=`</div><div class="flex"><span class="muted">${Object.keys(room.answers[q.id]||{}).length} respostas recebidas</span>${isHost()?`<div class="row"><button class="secondary" onclick="control('pause')">${room.paused?'▶ Retomar':'⏸ Pausar'}</button><button onclick="control('reveal')">Mostrar resultados →</button></div>`:''}</div></div>`;return h;}
function choose(v){chosen=v;send('answer',{value:v},()=>{chosen=null;toast('Resposta enviada! +100 XP para o time');});}
function sendOpen(){openText=$('freeAnswer').value.trim();send('answer',{value:openText},()=>{openText='';toast('Resposta enviada! +100 XP para o time');});}
function resultsView(){const q=question(),all=Object.entries(room.answers[q.id]||{}),count=all.length;let h=header()+`<div class="panel"><div class="flex"><span class="tag">Resultado • ${room.index+1}/${room.questions.length}</span><span class="tag">${count} respostas</span></div><h2 class="question">${esc(q.title)}</h2>`;
if(q.type==='choice'||q.type==='vote'){q.options.forEach((o,i)=>{const n=all.filter(([id,a])=>a.value===i).length;h+=`<div class="card"><div class="flex"><strong>${esc(o)}</strong><span>${n} • ${count?Math.round(n/count*100):0}%</span></div><div class="bar"><div class="fill" style="width:${count?n/count*100:0}%"></div></div></div>`;});}else if(q.type==='scale'){const avg=count?(all.reduce((s,[id,a])=>s+a.value,0)/count).toFixed(1):'—';h+=`<div class="hero"><div class="score">⭐ ${avg}/5</div><p>Média do time</p></div>`;}else{h+=all.length?all.map(([id,a])=>`<div class="card">💬 ${esc(a.value)}<div class="tiny">${q.anonymous?'Anônimo':esc(room.participants.find(p=>p.id===id)?.name||'Participante')}</div></div>`).join(''):'<p class="muted">Nenhuma resposta recebida.</p>';}
h+=`<div class="flex"><p class="muted">⭐ ${room.xp} XP coletivos</p>${isHost()?`<button class="good" onclick="control('next')">${room.index+1===room.questions.length?'Ir para planos de ação →':'Próxima pergunta →'}</button>`:'<span class="muted">Aguardando próxima rodada…</span>'}</div></div>`;return h;}
function actionsView(){return header()+`<div class="panel"><h2>🎯 Missão final: planos de ação</h2><p class="muted">Registrem compromissos claros para a próxima sprint. Cada ação adiciona 150 XP ao time.</p><label>O que vamos fazer?</label><textarea id="actionTitle" maxlength="240" placeholder="Ex.: Mapear dependências no planejamento e definir responsáveis"></textarea><div class="grid"><div><label>Responsável</label><input id="actionOwner" maxlength="80" placeholder="Nome"></div><div><label>Prazo</label><input id="actionDue" type="date"></div></div><p><button class="good" onclick="addAction()">+ Registrar ação</button></p><h3>Compromissos (${room.actions.length})</h3>${room.actions.map(a=>`<div class="card"><strong>${esc(a.title)}</strong><div class="tiny">Responsável: ${esc(a.owner||'A definir')} • Prazo: ${esc(a.due||'A definir')}</div></div>`).join('')||'<p class="muted">Nenhuma ação registrada.</p>'}${isHost()?'<p><button onclick="control(\'finish\')">🏆 Encerrar retrospectiva</button></p>':''}</div>`;}
function csv(v){return '"'+String(v??'').replace(/"/g,'""')+'"'}
function download(name,content,type){const a=document.createElement('a'),url=URL.createObjectURL(new Blob([content],{type}));a.href=url;a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000)}
function exportCSV(){let rows=[['Ação','Responsável','Prazo','Registrado por'],...room.actions.map(a=>[a.title,a.owner,a.due,a.createdBy])];download('planos-de-acao.csv','\ufeff'+rows.map(r=>r.map(csv).join(';')).join('\r\n'),'text/csv;charset=utf-8')}
function exportReport(){let body=`<h1>Sprint Challenge — ${esc(room.squad)}</h1><p>PIN ${esc(room.code)} | XP ${room.xp} | Participantes ${room.participants.length}</p>`;room.questions.forEach(q=>{body+=`<h2>${esc(q.title)}</h2><p>Tipo: ${esc(q.type)}</p>`;const a=Object.entries(room.answers[q.id]||{});a.forEach(([id,v])=>{const name=q.anonymous?'Anônimo':room.participants.find(p=>p.id===id)?.name||'Participante';body+=`<p><b>${esc(name)}:</b> ${esc(['choice','vote'].includes(q.type)?q.options[v.value]:v.value)}</p>`;});});body+='<h2>Planos de ação</h2>'+room.actions.map(a=>`<p>${esc(a.title)} — ${esc(a.owner)} — ${esc(a.due)}</p>`).join('');download('relatorio-sprint-challenge.html','<!doctype html><html lang="pt-BR"><meta charset="utf-8"><title>Relatório</title><body style="font:16px Arial;max-width:800px;margin:40px auto">'+body+'</body></html>','text/html;charset=utf-8')}
function finishedView(){return header()+`<div class="panel hero"><h1>🏆 Desafio concluído!</h1><div class="score">${room.xp} XP</div><p>O time transformou reflexões em ações.</p><p>${room.questions.length} perguntas • ${room.actions.length} planos de ação</p><div class="row" style="justify-content:center"><button class="good" onclick="exportReport()">📄 Baixar relatório</button><button onclick="exportCSV()">📊 Baixar ações CSV</button>${isHost()?'<button class="secondary" onclick="control(\'backLobby\')">Nova sessão</button>':''}</div></div>`;}
function addAction(){send('addAction',{title:$('actionTitle').value,owner:$('actionOwner').value,due:$('actionDue').value},()=>toast('Plano de ação registrado! +150 XP'));}
function control(action){send('control',{action},()=>{chosen=null;openText='';});}
function render(){if(!room)return startView();if(room.phase==='lobby')app.innerHTML=lobby();else if(room.phase==='question')app.innerHTML=questionView();else if(room.phase==='results')app.innerHTML=resultsView();else if(room.phase==='actions')app.innerHTML=actionsView();else app.innerHTML=finishedView();}
socket.on('connect',()=>{statusEl.textContent='🟢 Conectado';if(identity)send('join',{code:identity.code,id:identity.id,token:identity.token,name:identity.name,avatar:identity.avatar},r=>{identity.token=r.token||null;localStorage.setItem('sc_identity',JSON.stringify(identity));});else render();});
socket.on('disconnect',()=>{statusEl.textContent='🔴 Reconectando…';});
socket.on('state',data=>{const old=room?.phase,oldIndex=room?.index;room=data;if(old!==room.phase||oldIndex!==room.index){chosen=null;openText='';}if(document.activeElement?.matches('[data-i],#editSquad')&&room.phase==='lobby')return;if(document.activeElement?.id==='freeAnswer'&&room.phase==='question')return;if(document.activeElement?.matches('#actionTitle,#actionOwner,#actionDue')&&room.phase==='actions')return;render();});
window.addEventListener('beforeunload',()=>{});render();
</script></body></html>
